{
  // 重新部署
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-playground-react",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // S3 源站在 Supabase ap-southeast-2（悉尼）；
  // Smart Placement 把执行挪到靠近源站的 colo，降低上传/预签名延迟
  "placement": {
    "mode": "smart",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "CODEBENCH_API_URL": "https://codebenchagent.vercel.app",
    "SUPABASE_S3_ENDPOINT": "https://krgaimtoeuorzifkahsk.storage.supabase.co/storage/v1/s3",
    "SUPABASE_S3_REGION": "ap-southeast-2",
    // Turnstile siteverify 的前端主机名白名单（生产域名，不含 localhost）；
    // 本地开发走 .env.local 或代码默认值 localhost,127.0.0.1
    "TURNSTILE_HOSTNAMES": "personal-playground-react.kkyy.dpdns.org,react-demo.kkyy.dpdns.org,kkyy.dpdns.org",
    // Cloudflare RealtimeKit（1v1 视频 / 语音通话）；API Token 为机密，用 `wrangler secret put` 设置
    "CLOUDFLARE_ACCOUNT_ID": "65844ae2478b17ef0b07680420bc454f",
    "REALTIMEKIT_APP_ID": "b864de47-60f4-4ba4-adf6-281a4807971d",
    // Supabase：URL 与 anon key 设计上可公开，走明文 vars；S3 两个 key 是机密走 secret put
    "SUPABASE_URL": "https://krgaimtoeuorzifkahsk.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_2EwJxFI9RShlvkDNznumnw_Kzb0D5cD",
  },
  // ...
  // 机密（TURNSTILE_SECRET / SUPABASE_S3_ACCESS_KEY_ID / SUPABASE_S3_SECRET_ACCESS_KEY /
  // UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN / CLOUDFLARE_REALTIME_API_TOKEN）
  // 用 `npx wrangler secret put <NAME> --name personal-playground-react` 设置
}
